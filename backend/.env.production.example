# ==========================================
# Onuvuti Production Environment Configuration (AWS)
# ==========================================

# Port the Go backend listens on (Default: 8081 or AWS standard 80/8080)
PORT=8081
APP_ENV=production

# AWS RDS PostgreSQL connection string (Replace with your actual RDS credentials & endpoint)
# Format: postgres://<user>:<password>@<rds-endpoint>:5432/<database>?sslmode=require
DATABASE_URL=postgres://onuvuti_admin:your_secure_db_password@onuvuti-postgres.cxxxxxx.us-east-1.rds.amazonaws.com:5432/onuvuti?sslmode=require

# Admin Dashboard Password (change to a strong secret)
ADMIN_PASSWORD=change_this_to_a_strong_admin_password_2026

# Admin & User Token HMAC Secret (generate with: openssl rand -hex 32)
ADMIN_TOKEN_SECRET=replace_with_64_char_random_hex_secret_key_for_jwt

# Allowed CORS origins (comma-separated, your Next.js domain)
CORS_ALLOWED_ORIGINS=https://onuvuti.site,https://www.onuvuti.site,http://localhost:3000

# Google OAuth Client ID (from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

