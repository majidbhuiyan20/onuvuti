# ==============================================================================
# ONUVUTI (অনুভূতি) - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.production or .env.local on the AWS EC2 server
# NEVER commit actual secrets into Git!
# ==============================================================================

# Node Environment
NODE_ENV=production
APP_ENV=production
PORT=3000

# Canonical Public Website URL (Do not include trailing slash)
NEXT_PUBLIC_SITE_URL=https://onuvuti.site

# ZiniPay Live Payment Gateway Credentials
# Retrieve from ZiniPay Merchant Dashboard -> Brands -> API Keys
ZINIPAY_API_KEY="YOUR_ACTUAL_ZINIPAY_BRAND_API_KEY"
ZINIPAY_BASE_URL="https://api.zinipay.com"

# Webhook Secret (HMAC-SHA256 signature verification)
# Must match the secret configured in ZiniPay Dashboard -> Webhooks -> Secret Key
ZINIPAY_WEBHOOK_SECRET="GENERATE_A_32_CHAR_RANDOM_SECRET_FOR_WEBHOOK"

# E-Book Configuration
BOOK_PRICE_BDT="99"
NEXT_PUBLIC_MERCHANT_NUMBER="01700-000000"

# Download Token & Order Signing Secret (MANDATORY in Production)
# Must be at least 32 characters long.
# Generate via: openssl rand -hex 32
ORDER_SECRET_KEY="GENERATE_A_64_CHAR_HEX_SECRET_KEY_USING_OPENSSL"

# Admin Dashboard Access
ADMIN_SECRET_PASSWORD="GENERATE_STRONG_RANDOM_ADMIN_PASSWORD"

# Internal Go Backend Microservice Bridge (Local loopback)
GO_API_BASE_URL="http://127.0.0.1:8081/api/v1"
